{
  "template_id": "feature.standard",
  "version": "1.0",
  "description": "A capability that does not exist yet. Story plus mandatory ARCHITECTURE - a new capability is a new contract boundary by construction - and DEPLOY with PRODUCTION_VALIDATION where production.applicable. The two production stages share one applicability predicate, so they are included or excluded together: a deploy with no production validation after it is a deploy nobody knows the outcome of.",
  "applies_to": {
    "types": [
      "FEATURE"
    ]
  },
  "entry": "AUDIT",
  "stages": [
    "AUDIT",
    "ARCHITECTURE",
    "PLAN",
    "IMPLEMENTATION",
    "VALIDATION",
    "STRUCTURAL_REAUDIT",
    "UX_REVIEW",
    "REWORK",
    "PR_PREPARATION",
    "PR_REVIEW",
    "REVIEW_TRIAGE",
    "COMMENT_RESOLUTION",
    "AUTHORIZATION",
    "MERGE",
    "DEPLOY",
    "PRODUCTION_VALIDATION",
    "COMPLETION"
  ],
  "optional_stages": [
    "UX_REVIEW",
    "DEPLOY",
    "PRODUCTION_VALIDATION"
  ],
  "edges": [
    {
      "from": "AUDIT",
      "to": "ARCHITECTURE",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "ARCHITECTURE",
      "to": "PLAN",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "PLAN",
      "to": "IMPLEMENTATION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "IMPLEMENTATION",
      "to": "VALIDATION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "IMPLEMENTATION",
      "to": "ARCHITECTURE",
      "when": "envelope.BLOCKED_BY_ARCHITECTURE",
      "kind": "loop",
      "counter": "architecture",
      "cap": "budgets.loops.architecture"
    },
    {
      "from": "VALIDATION",
      "to": "REWORK",
      "when": "envelope.REJECTED",
      "kind": "loop",
      "counter": "rework",
      "cap": "budgets.loops.rework"
    },
    {
      "from": "REWORK",
      "to": "IMPLEMENTATION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "VALIDATION",
      "to": "STRUCTURAL_REAUDIT",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "STRUCTURAL_REAUDIT",
      "to": "UX_REVIEW",
      "when": "ux.required",
      "kind": "branch"
    },
    {
      "from": "STRUCTURAL_REAUDIT",
      "to": "PR_PREPARATION",
      "when": "NOT ux.required",
      "kind": "branch"
    },
    {
      "from": "UX_REVIEW",
      "to": "REWORK",
      "when": "envelope.REJECTED",
      "kind": "loop",
      "counter": "rework",
      "cap": "budgets.loops.rework"
    },
    {
      "from": "UX_REVIEW",
      "to": "PR_PREPARATION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "PR_PREPARATION",
      "to": "PR_REVIEW",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "PR_REVIEW",
      "to": "REVIEW_TRIAGE",
      "when": "reality.pr_has_unresolved_comments",
      "kind": "loop",
      "counter": "review",
      "cap": "budgets.loops.review"
    },
    {
      "from": "PR_REVIEW",
      "to": "AUTHORIZATION",
      "when": "reality.pr_approved",
      "kind": "advance"
    },
    {
      "from": "REVIEW_TRIAGE",
      "to": "COMMENT_RESOLUTION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "COMMENT_RESOLUTION",
      "to": "IMPLEMENTATION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "AUTHORIZATION",
      "to": "MERGE",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "MERGE",
      "to": "DEPLOY",
      "when": "production.applicable",
      "kind": "branch"
    },
    {
      "from": "MERGE",
      "to": "COMPLETION",
      "when": "NOT production.applicable",
      "kind": "branch"
    },
    {
      "from": "DEPLOY",
      "to": "PRODUCTION_VALIDATION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "PRODUCTION_VALIDATION",
      "to": "COMPLETION",
      "when": "always",
      "kind": "advance"
    },
    {
      "from": "PRODUCTION_VALIDATION",
      "to": "BLOCKED",
      "when": "envelope.REJECTED",
      "kind": "escalate",
      "blocker_kind": "AUTHORIZATION_REQUIRED"
    },
    {
      "from": "COMPLETION",
      "to": "COMPLETE",
      "when": "always",
      "kind": "terminal"
    }
  ],
  "dod_profile_default": "service-capability"
}
