{
  "name": "agentos",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "contracts",
    "policies",
    "registries",
    "state",
    "adapters",
    "discovery",
    "agents",
    "core",
    "tools"
  ],
  "scripts": {
    "clean": "node tools/bin/clean.mjs",
    "codegen": "node tools/bin/codegen.mjs",
    "codegen:check": "node tools/bin/codegen.mjs --check",
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "npm run build && npm run test:all",
    "boundary": "depcruise --config .dependency-cruiser.cjs contracts/src policies/src registries/src state/src adapters/src discovery/src agents/src core/src",
    "boundary:delete-core": "node tools/bin/delete-core-test.mjs",
    "verify": "node tools/bin/verify.mjs",
    "test:all": "node tools/bin/test.mjs",
    "test:one": "node --test --test-reporter=spec",
    "freeze": "node tools/bin/freeze-manifest.mjs",
    "freeze:check": "node tools/bin/freeze-manifest.mjs --check",
    "ajv-parity": "node tools/bin/ajv-parity.mjs",
    "conformance": "node tools/bin/conformance.mjs",
    "agentos": "node core/dist/src/cli/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
